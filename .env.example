# Copy this file to .env and fill it in:   cp .env.example .env   (Windows: copy .env.example .env)
# NEVER commit .env to GitHub (it is in .gitignore).

# ---- Which AI model drives the agent: gemini | openai | offline
LLM_PROVIDER=gemini

# ---- Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Free keys have small daily limits per model. If one model says "quota exceeded",
# the agent automatically moves to the next model in this list.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite

# ---- OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---- FalkorDB. Local Docker: keep these. FalkorDB Cloud: paste host/port/username/password from the cloud console.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
GRAPH_NAME=upi_fraud
